#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    macros {
        CPU125: CPU125 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(E) &kp L &kp Y &kp S &kp I &kp U &kp M &kp DOT &kp N4 &kp N5 &kp N6 &kp ENTER>;
            label = "CPU125";
        };

        CPU108_Bios: CPU125_Bios {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp B &kp E &kp R &kp O &kp X &kp MINUS &kp F &kp O &kp O &kp MINUS &kp N9 &kp N0 &kp N1 &kp N7 &kp ENTER>;
            label = "CPU125_BIOS";
        };

        CPU108: CPU108 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(K) &kp I &kp T &kp S &kp U &kp R &kp A &kp G &kp I &kp DOT &kp N4 &kp N5 &kp N6 &kp ENTER>;
            label = "CPU108";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Default Layer";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BSPC |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&kp TAB           &kp Q         &kp W  &kp E         &kp R  &kp T        &kp Y        &kp U  &kp I         &kp O      &kp P       &kp BSPC
&kp LEFT_SHIFT    &kp A         &kp S  &kp D         &kp F  &kp G        &kp H        &kp J  &kp K         &kp L      &kp SEMI    &kp APOS
&kp LEFT_CONTROL  &kp LEFT_WIN  &kp Z  &kp X         &kp C  &kp V        &kp B        &kp N  &kp M         &kp COMMA  &kp PERIOD  &kp RIGHT_CONTROL
                                       &kp LEFT_ALT  &mo 1  &kp SPACE    &lt 2 ENTER  &mo 1  &kp LEFT_ALT
            >;
        };

        lower_layer {
            display-name = "Lower Layer";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BSPC |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp ESCAPE            &kp N1        &kp N2  &kp N3        &kp N4  &trans    &trans        &trans    &kp UP        &kp MINUS         &kp EQUAL          &kp BSPC
&mt LEFT_SHIFT GRAVE  &trans        &kp N5  &kp NUMBER_6  &kp N7  &trans    &trans        &kp LEFT  &kp DOWN      &kp RIGHT         &kp SLASH          &kp BACKSLASH
&kp LEFT_CONTROL      &kp LEFT_WIN  &kp N8  &kp N9        &kp N0  &trans    &trans        &trans    &trans        &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &trans
                                            &kp LEFT_ALT  &trans  &mo 2     &lt 2 INSERT  &trans    &kp LEFT_ALT
            >;
        };

        raise_layer {
            display-name = "Raise Layer";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BSPC |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp TAB           &trans        &kp F1  &kp F2     &kp F3   &kp F4     &kp C_PLAY_PAUSE  &trans      &kp C_VOLUME_UP    &trans        &trans   &kp DELETE
&kp CAPSLOCK      &trans        &kp F5  &kp F6     &kp F7   &kp F8     &trans            &kp C_PREV  &kp C_VOLUME_DOWN  &kp C_NEXT    &trans   &trans
&kp LEFT_CONTROL  &kp LEFT_ALT  &kp F9  &kp F10    &kp F11  &kp F12    &bt BT_PRV        &bt BT_NXT  &trans             &CPU108_Bios  &CPU108  &CPU125
                                        &kp SPACE  &trans   &trans     &trans            &trans      &kp LEFT_ALT
            >;
        };
    };
};
